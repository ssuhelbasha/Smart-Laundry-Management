{
  "name": "smart-laundry-appium-tests",
  "version": "1.0.0",
  "description": "Enterprise Appium E2E Test Framework for Smart Laundry Android App",
  "main": "index.js",
  "scripts": {
    "test": "node tests/run-all-tests.js",
    "test:auth": "mocha tests/auth/*.test.js --timeout 120000 --exit",
    "test:orders": "mocha tests/orders/*.test.js --timeout 120000 --exit",
    "test:navigation": "mocha tests/navigation/*.test.js --timeout 120000 --exit",
    "test:smoke": "mocha tests/smoke/*.test.js --timeout 60000 --exit",
    "generate:report": "node utils/report-generator.js --format all",
    "generate:testcases": "node utils/test-case-generator.js"
  },
  "dependencies": {
    "webdriverio": "^8.38.0",
    "@wdio/appium-service": "^8.38.0",
    "exceljs": "^4.4.0",
    "mocha": "^10.6.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "chai": "^4.4.1",
    "fs-extra": "^11.2.0",
    "moment": "^2.30.1",
    "uuid": "^10.0.0",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}
